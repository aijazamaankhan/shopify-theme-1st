{%- assign s = section.settings -%}
<section class="section section-padding color-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {%- render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: s.heading_align -%}
    <ul class="testimonials testimonials--{{ s.layout }}" role="list" aria-label="{{ 'general.testimonials.label' | t }}" style="--cols-desktop: {{ s.columns }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="testimonial" data-reveal style="--reveal-index: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <figure class="testimonial__figure">
            <blockquote class="testimonial__quote">{{ b.quote | escape }}</blockquote>
            <figcaption class="testimonial__author">
              {%- if b.image != blank -%}<span class="testimonial__avatar media" style="--ratio: 1 / 1;">{%- render 'image', image: b.image, sizes: '56px', widths: '56,112,168', loading: 'lazy', alt: '' -%}</span>{%- endif -%}
              <span><span class="testimonial__name">{{ b.author | escape }}</span>{%- if b.role != blank -%}<span class="caption testimonial__role">{{ b.role | escape }}</span>{%- endif -%}</span>
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In their words" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "grid", "label": "Grid" }, { "value": "scroll", "label": "Horizontal scroll" } ], "default": "grid" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "Only use real customer feedback you have permission to publish.", "default": "Replace with a real customer quote." },
        { "type": "text", "id": "author", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "role", "label": "Detail", "info": "For example: verified buyer, city." },
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [ { "name": "Testimonials", "blocks": [ { "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" } ] } ]
}
{% endschema %}
