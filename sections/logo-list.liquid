{%- assign s = section.settings -%}
<section class="section section-padding color-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {%- render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: s.heading_align -%}
    <ul class="logo-list" role="list" style="--logo-height: {{ s.logo_height }}px;">
      {%- for block in section.blocks -%}
        <li class="logo-list__item" data-reveal style="--reveal-index: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- capture logo_img -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: height: s.logo_height, width: block.settings.image.aspect_ratio | times: s.logo_height | round, loading: 'lazy', widths: '200,300,400', alt: block.settings.image.alt | default: block.settings.name }}
            {%- else -%}
              {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="logo-list__link">{{ logo_img }}</a>{%- else -%}{{ logo_img }}{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Logo list",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen in" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Name (alt text)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Logo list", "blocks": [ { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" } ] } ]
}
{% endschema %}
