{%- liquid
  assign scheme = section.settings.color_scheme
-%}
<footer class="site-footer color-{{ scheme }}">
  <div class="site-footer__main section-padding" style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="page-width">
      <div class="site-footer__grid" data-blocks="{{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          <div class="footer-block footer-block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'brand' -%}
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 480 | image_tag: width: block.settings.logo_width, loading: 'lazy', class: 'footer-block__logo', alt: shop.name }}
                {%- else -%}
                  <p class="footer-block__brand h3">{{ shop.name | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}<div class="rte footer-block__text">{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.show_social -%}{%- render 'social-links', class: 'footer-block__social' -%}{%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}<h2 class="footer-block__heading label">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer-block__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}" class="footer-link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}<h2 class="footer-block__heading label">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                <div class="rte footer-block__text">{{ block.settings.text }}</div>

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}<h2 class="footer-block__heading label">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                {%- if block.settings.text != blank -%}<p class="footer-block__text">{{ block.settings.text | escape }}</p>{%- endif -%}
                {%- render 'newsletter-form', id: 'FooterNewsletter', class: 'newsletter-form' -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="page-width site-footer__bottom-inner">
      <div class="site-footer__legal caption">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
        {%- if section.settings.show_policies -%}
          <ul class="site-footer__policies" role="list">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if section.settings.show_localization -%}
        {%- render 'localization-form', id: 'FooterLocalization' -%}
      {%- endif -%}

      {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" role="list" aria-label="{{ 'general.payment.methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" },
    { "type": "checkbox", "id": "show_localization", "label": "Show language and country selectors", "info": "Only appears when your store sells in more than one market or language.", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo (optional)" },
        { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 10, "unit": "px", "default": 140 },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Considered pieces for the home and the wardrobe, made to be kept.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your studio address, opening hours or customer care details.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in touch" },
        { "type": "text", "id": "text", "label": "Text", "default": "New arrivals and stories, sent sparingly." }
      ]
    }
  ]
}
{% endschema %}
