{%- liquid
  assign s = section.settings
  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif
  assign img_loading = 'lazy'
  assign img_priority = 'auto'
  if is_first
    assign img_loading = 'eager'
    assign img_priority = 'high'
  endif
  assign has_video = false
  if s.video != blank
    assign has_video = true
  endif
  assign overlay = s.overlay_opacity | divided_by: 100.0
-%}
<section
  class="hero hero--{{ s.height }} hero--{{ s.layout }} color-{{ s.color_scheme }}"
  data-text="{{ s.text_color }}"
  data-motion="{{ s.image_motion }}"
  {% if s.header_overlap and s.layout == 'full' %}data-header-overlap{% endif %}
  style="--overlay: {{ overlay }}; --content-width: {{ s.content_width }}px;"
>
  {%- if s.layout == 'full' -%}
    <div class="hero__media{% if s.image_motion %} hero__media--intro{% endif %}"{% if s.image_motion %} data-parallax="60"{% endif %}>
      {%- if has_video -%}
        <hero-video class="hero__video-wrap">
          <video
            class="hero__video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            {% if s.image != blank %}poster="{{ s.image | image_url: width: 1500 }}"{% endif %}
            aria-hidden="true"
            tabindex="-1"
          >
            {%- for source in s.video.sources reversed -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>
          <button type="button" class="hero__video-toggle icon-button" data-toggle aria-pressed="false">
            <span data-icon-pause>{%- render 'icon', name: 'pause' -%}</span>
            <span data-icon-play hidden>{%- render 'icon', name: 'play' -%}</span>
            <span class="visually-hidden">{{ 'general.video.pause_background' | t }}</span>
          </button>
        </hero-video>
      {%- elsif s.image != blank -%}
        {%- render 'responsive-picture',
          desktop: s.image,
          mobile: s.image_mobile,
          loading: img_loading,
          fetchpriority: img_priority,
          class: 'hero__image',
          alt: s.image.alt
        -%}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hero__placeholder' }}
      {%- endif -%}
      <div class="hero__overlay" aria-hidden="true"></div>
    </div>
  {%- endif -%}

  <div class="hero__layout page-width hero__layout--v-{{ s.vertical_position }}">
    <div class="hero__content hero__content--{{ s.content_alignment }}">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow hero__eyebrow" style="--i: 0;">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h1 class="hero__heading h0" style="--i: 1;">{{ s.heading | escape }}</h1>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="hero__text rte lead" style="--i: 2;">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.primary_label != blank or s.secondary_label != blank -%}
        <div class="hero__buttons" style="--i: 3;">
          {%- if s.primary_label != blank -%}
            <a href="{{ s.primary_link | default: '#' }}" class="button">
              {{ s.primary_label | escape }}
              {%- if settings.button_arrow %} {% render 'icon', name: 'arrow-right', class: 'button__arrow' %}{% endif -%}
            </a>
          {%- endif -%}
          {%- if s.secondary_label != blank -%}
            <a href="{{ s.secondary_link | default: '#' }}" class="button-outline">{{ s.secondary_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if s.layout == 'split' -%}
      <div class="hero__split-media">
        <div class="hero__split-primary media" style="--ratio: 4 / 5;">
          {%- if s.image != blank -%}
            {%- render 'responsive-picture',
              desktop: s.image,
              mobile: s.image_mobile,
              loading: img_loading,
              fetchpriority: img_priority,
              sizes: '(min-width: 990px) 40vw, 100vw',
              class: 'hero__image',
              alt: s.image.alt
            -%}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="hero__split-secondary media" style="--ratio: 3 / 4;">
          {%- if s.image_secondary != blank -%}
            {%- render 'image', image: s.image_secondary, sizes: '(min-width: 990px) 22vw, 50vw', widths: '360,540,720,900', loading: img_loading, alt: s.image_secondary.alt -%}
          {%- else -%}
            {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "full", "label": "Full-bleed image or video" },
        { "value": "split", "label": "Split: text with image pair" }
      ],
      "default": "full"
    },
    {
      "type": "select", "id": "height", "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    { "type": "checkbox", "id": "header_overlap", "label": "Header overlaps this section", "info": "With a transparent header enabled in the header settings, the header floats over this hero (full-bleed layout only).", "default": true },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape, at least 2000px wide. Set the focal point in the image library so the subject stays visible when cropped." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional portrait image shown below 750px." },
    { "type": "image_picker", "id": "image_secondary", "label": "Second image (split layout)" },
    { "type": "video", "id": "video", "label": "Background video", "info": "Optional. Muted, looping and pausable; the image above is used as the poster. Keep it short and compressed." },
    { "type": "checkbox", "id": "image_motion", "label": "Subtle image motion", "info": "Gentle settle-in on load and light parallax. Disabled for visitors who prefer reduced motion.", "default": true },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to be lived with" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Considered pieces for the home and the wardrobe, chosen for how well they age.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop the collection" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "header", "content": "Position and readability" },
    {
      "type": "select", "id": "content_alignment", "label": "Content position",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "select", "id": "vertical_position", "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 640 },
    {
      "type": "select", "id": "text_color", "label": "Text colour on image",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "info": "Used by the split layout.", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
