{%- liquid
  assign s = section.settings
-%}
<section class="split-screen split-screen--{{ s.height }}">
  <div class="split-screen__grid">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div class="split-panel color-{{ b.color_scheme }}" {{ block.shopify_attributes }} data-text="{{ b.text_color }}">
        <div class="split-panel__media"{% if s.parallax %} data-parallax="40"{% endif %}>
          {%- if b.image != blank -%}
            {%- render 'image', image: b.image, sizes: '(min-width: 750px) 50vw, 100vw', widths: '540,750,1000,1400,1800', loading: 'lazy', alt: b.image.alt -%}
          {%- else -%}
            {{ 'hero-apparel-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <div class="hero__overlay" style="--overlay: {{ b.overlay_opacity | divided_by: 100.0 }};" aria-hidden="true"></div>
        </div>
        <div class="split-panel__content stack" style="--stack-gap: 1rem;" data-reveal>
          {%- if b.eyebrow != blank -%}<p class="eyebrow">{{ b.eyebrow | escape }}</p>{%- endif -%}
          {%- if b.heading != blank -%}<h2 class="h2">{{ b.heading | escape }}</h2>{%- endif -%}
          {%- if b.text != blank -%}<div class="rte">{{ b.text }}</div>{%- endif -%}
          {%- if b.button_label != blank -%}
            <div><a href="{{ b.button_link | default: '#' }}" class="button">{{ b.button_label | escape }}</a></div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Split screen",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "height", "label": "Height", "options": [ { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ], "default": "large" },
    { "type": "checkbox", "id": "parallax", "label": "Subtle image parallax", "default": false }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "For the home" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop home" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "select", "id": "text_color", "label": "Text colour", "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ], "default": "light" },
        { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
        { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Split screen", "blocks": [ { "type": "panel" }, { "type": "panel", "settings": { "heading": "For the wardrobe", "button_label": "Shop wardrobe" } } ] }
  ]
}
{% endschema %}
