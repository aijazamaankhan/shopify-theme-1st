{%- liquid
  assign s = section.settings
-%}
{%- if section.blocks.size > 0 -%}
  <marquee-bar
    class="marquee color-{{ s.color_scheme }}"
    style="--marquee-speed: {{ s.speed }}s;"
    data-direction="{{ s.direction }}"
    role="region"
    aria-label="{{ 'general.marquee.label' | t }}"
  >
    <div class="marquee__viewport">
      <div class="marquee__track" data-track>
        {%- for copy in (1..2) -%}
          <ul class="marquee__group" role="list"{% if copy == 2 %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              <li class="marquee__item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank and copy == 1 -%}
                  <a href="{{ block.settings.link }}" class="marquee__text h3">{{ block.settings.text | escape }}</a>
                {%- else -%}
                  <span class="marquee__text h3">{{ block.settings.text | escape }}</span>
                {%- endif -%}
                <span class="marquee__sep" aria-hidden="true">{% render 'icon', name: 'sparkle' %}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
    <button type="button" class="marquee__toggle icon-button" data-toggle aria-pressed="false">
      <span data-icon-pause>{%- render 'icon', name: 'pause' -%}</span>
      <span data-icon-play hidden>{%- render 'icon', name: 'play' -%}</span>
      <span class="visually-hidden">{{ 'general.slider.pause' | t }}</span>
    </button>
  </marquee-bar>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling text",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 12, "max": 80, "step": 4, "unit": "s", "info": "Higher is slower. The text stays still for visitors who prefer reduced motion and can be paused.", "default": 40 },
    { "type": "select", "id": "direction", "label": "Direction", "options": [ { "value": "left", "label": "Right to left" }, { "value": "right", "label": "Left to right" } ], "default": "left" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free returns" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Scrolling text", "blocks": [ { "type": "text", "settings": { "text": "Made to last" } }, { "type": "text", "settings": { "text": "Small batches" } }, { "type": "text", "settings": { "text": "Thoughtfully packaged" } } ] }
  ]
}
{% endschema %}
