{%- liquid
  assign s = section.settings
  case s.ratio
    when 'portrait'
      assign ratio_value = '4 / 5'
    when 'square'
      assign ratio_value = '1 / 1'
    when 'landscape'
      assign ratio_value = '4 / 3'
    else
      assign ratio_value = '3 / 4'
  endcase
-%}
<section class="section section-padding color-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="image-text image-text--{{ s.image_position }} image-text--size-{{ s.image_width }}">
      <div class="image-text__media-wrap" data-reveal="fade">
        <div class="image-text__media media" style="--ratio: {{ ratio_value }};"{% if s.parallax %} data-parallax="30"{% endif %}>
          {%- if s.image != blank -%}
            {%- render 'image', image: s.image, sizes: '(min-width: 990px) 50vw, 100vw', widths: '540,720,900,1200,1600', loading: 'lazy', class: 'image-text__image', alt: s.image.alt -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if s.image_secondary != blank -%}
          <div class="image-text__inset media" style="--ratio: 4 / 5;">
            {%- render 'image', image: s.image_secondary, sizes: '(min-width: 990px) 20vw, 40vw', widths: '240,360,480,640', loading: 'lazy', alt: s.image_secondary.alt -%}
          </div>
        {%- endif -%}
      </div>

      <div class="image-text__content stack" style="--stack-gap: 1.25rem;">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p class="eyebrow" data-reveal {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- when 'heading' -%}
              <h2 class="{{ block.settings.size }}" data-reveal {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
            {%- when 'text' -%}
              <div class="rte" data-reveal {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'list' -%}
              <ul class="check-list" role="list" data-reveal {{ block.shopify_attributes }}>
                {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for item in items -%}
                  {%- assign trimmed = item | strip | strip_newlines -%}
                  {%- if trimmed != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ trimmed | escape }}</span></li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- when 'button' -%}
              {%- if block.settings.label != blank -%}
                <div data-reveal {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link | default: '#' }}" class="{% if block.settings.style == 'outline' %}button-outline{% elsif block.settings.style == 'text' %}button-text link-arrow{% else %}button{% endif %}">
                    {{ block.settings.label | escape }}
                    {%- if block.settings.style == 'text' %} {% render 'icon', name: 'arrow-right', class: 'button__arrow' %}{% endif -%}
                  </a>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_secondary", "label": "Inset image", "info": "Optional small image overlapping the main one for an editorial feel." },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "image_width", "label": "Image width", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ], "default": "medium" },
    {
      "type": "select", "id": "ratio", "label": "Image ratio",
      "options": [
        { "value": "tall", "label": "Tall (3:4)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "parallax", "label": "Subtle image parallax", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Our approach" } ] },
    {
      "type": "heading", "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Designed slowly, made carefully" },
        { "type": "select", "id": "size", "label": "Size", "options": [ { "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" } ], "default": "h2" }
      ]
    },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell the story behind your products: where they come from, who makes them and why they matter.</p>" } ] },
    { "type": "list", "name": "Check list", "settings": [ { "type": "textarea", "id": "items", "label": "Items", "info": "One item per line.", "default": "Responsibly sourced materials\nMade in small batches\nRepairable and built to last" } ] },
    {
      "type": "button", "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Read our story" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }, { "value": "text", "label": "Text link" } ], "default": "outline" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "button" } ]
    }
  ]
}
{% endschema %}
