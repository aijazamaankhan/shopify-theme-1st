{%- comment -%}
  Inline SVG icons. Decorative by default (aria-hidden); pair with visible/visually-hidden text.
  Params: name (required), class (optional)
{%- endcomment -%}
{%- liquid
  assign cls = 'icon icon-' | append: name
  if class != blank
    assign cls = cls | append: ' ' | append: class
  endif
-%}
{%- case name -%}
