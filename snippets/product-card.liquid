{%- comment -%}
  Product card.
  Params: product (required), index (int, for reveal stagger), loading ('lazy'|'eager'), sizes, quick_add (bool, default from settings), class
{%- endcomment -%}
{%- liquid
  assign card_loading = loading | default: 'lazy'
  assign primary_alt = product.featured_media.alt | default: ''
  assign card_sizes = sizes | default: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign show_quick = quick_add
  if quick_add == nil
    assign show_quick = settings.quick_add
  endif
  assign hover = settings.card_hover
  assign second_image = product.images[1]
  if hover != 'swap'
    assign second_image = nil
  endif
  assign ratio = settings.card_ratio
  case ratio
    when 'portrait'
      assign ratio_value = '4 / 5'
    when 'tall'
      assign ratio_value = '3 / 4'
    when 'square'
      assign ratio_value = '1 / 1'
    when 'landscape'
      assign ratio_value = '4 / 3'
    else
      assign ratio_value = product.featured_media.aspect_ratio | default: 1
  endcase
  assign card_id = 'ProductCard-' | append: section.id | append: '-' | append: product.id
-%}
<article
  class="product-card product-card--{{ settings.card_align }}{% if hover == 'zoom' %} product-card--zoom{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  data-product-card
  data-reveal
  style="--reveal-index: {{ index | default: 0 | at_most: 8 }};"
>
  <div class="product-card__media-wrap">
    <div class="product-card__media media" style="--ratio: {{ ratio_value }};" aria-hidden="true">
      {%- if product.featured_media -%}
        {%- render 'image',
          image: product.featured_media.preview_image,
          sizes: card_sizes,
          widths: '240,360,480,640,800,1000',
          loading: card_loading,
          class: 'product-card__image product-card__image--primary',
          alt: primary_alt
        -%}
        {%- if second_image and second_image.id != product.featured_media.preview_image.id -%}
          {%- render 'image',
            image: second_image,
            sizes: card_sizes,
            widths: '240,360,480,640,800,1000',
            loading: 'lazy',
            class: 'product-card__image product-card__image--secondary',
            alt: ''
          -%}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="product-card__badges">{% render 'product-badges', product: product %}</div>

    {%- if show_quick -%}
      <div class="product-card__quick">
        {%- if product.variants.size == 1 and product.available -%}
          {%- form 'product', product, id: card_id, class: 'product-card__quick-form', data-ajax-cart: 'true' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="button button--small button--full product-card__quick-button" data-add-button aria-describedby="{{ card_id }}-title">
              <span data-add-label>{{ 'products.product.quick_add' | t }}</span>
              {%- render 'loading-spinner' -%}
            </button>
          {%- endform -%}
        {%- elsif product.available -%}
          <a href="{{ product.url }}" class="button button--small button--full product-card__quick-button" aria-describedby="{{ card_id }}-title">
            {{ 'products.product.choose_options' | t }}
          </a>
        {%- else -%}
          <span class="button button--small button--full product-card__quick-button" aria-disabled="true" aria-describedby="{{ card_id }}-title">{{ 'products.product.sold_out' | t }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <p class="product-card__vendor caption">{{ product.vendor | escape }}</p>
    {%- endif -%}
    <h3 class="product-card__title h5" id="{{ card_id }}-title">
      <a href="{{ product.url }}" class="product-card__link">{{ product.title | escape }}</a>
    </h3>
    {%- if settings.card_show_rating and product.metafields.reviews.rating.value != blank -%}
      <p class="product-card__rating caption">
        <span aria-hidden="true">{% render 'icon', name: 'star' %} {{ product.metafields.reviews.rating.value }}</span>
        <span class="visually-hidden">{{ 'products.product.rating_label' | t: rating: product.metafields.reviews.rating.value, max: product.metafields.reviews.rating.value.scale_max }}</span>
        {%- if product.metafields.reviews.rating_count != blank -%}<span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>{%- endif -%}
      </p>
    {%- endif -%}
    {%- render 'price', product: product -%}
    {%- if settings.card_show_swatches -%}
      {%- for option in product.options_with_values -%}
        {%- assign opt_name = option.name | downcase -%}
        {%- if opt_name contains 'colo' or opt_name contains 'farbe' or opt_name contains 'couleur' -%}
          {%- assign shown = 0 -%}
          <ul class="swatch-dots" role="list" aria-label="{{ option.name | escape }}">
            {%- for value in option.values -%}
              {%- if shown < 5 -%}
                {%- assign swatch = value.swatch -%}
                {%- if swatch -%}
                  {%- assign shown = shown | plus: 1 -%}
                  <li class="swatch-dot" title="{{ value | escape }}" style="{% if swatch.image %}background-image: url({{ swatch.image | image_url: width: 40 }});{% else %}--swatch: {{ swatch.color }};{% endif %}"><span class="visually-hidden">{{ value | escape }}</span></li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if option.values.size > 5 -%}<li class="swatch-more caption">+{{ option.values.size | minus: 5 }}</li>{%- endif -%}
          </ul>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</article>
