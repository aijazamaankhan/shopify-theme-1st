{%- comment -%} Country/region and language selectors via Shopify's localization form. Params: id {%- endcomment -%}
{%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
  {%- form 'localization', id: id, class: 'localization-form' -%}
    <div class="localization-form__fields">
      {%- if localization.available_languages.size > 1 -%}
        <div class="localization-form__field">
          <label class="visually-hidden" for="{{ id }}-language">{{ 'general.localization.language' | t }}</label>
          <select id="{{ id }}-language" name="language_code" class="select select--small" data-auto-submit>
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
      {%- if localization.available_countries.size > 1 -%}
        <div class="localization-form__field">
          <label class="visually-hidden" for="{{ id }}-country">{{ 'general.localization.country' | t }}</label>
          <select id="{{ id }}-country" name="country_code" class="select select--small" data-auto-submit>
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
      <noscript><button type="submit" class="button button--small">{{ 'general.localization.update' | t }}</button></noscript>
    </div>
  {%- endform -%}
{%- endif -%}
