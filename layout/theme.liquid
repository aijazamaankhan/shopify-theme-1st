<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if localization.language.rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_schemes.first.settings.background | default: '#F6F2EC' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ 'general.meta.tagged' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif %}

    {% render 'meta-tags' %}

    {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: '' }}
    {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: '' }}

    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}

    {%- if settings.page_transitions %}
      <style>
        @media (prefers-reduced-motion: no-preference) {
          @view-transition { navigation: auto; }
        }
      </style>
    {%- endif %}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    {%- if settings.predictive_search -%}
      <script src="{{ 'search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body
    class="color-{{ settings.color_schemes.first.id | default: 'scheme-1' }} template-{{ template.name | handle }}{% if template.suffix != blank %} template-suffix-{{ template.suffix | handle }}{% endif %}"
    data-animations="{{ settings.animations }}"
    data-parallax="{{ settings.parallax }}"
    data-cart-type="{{ settings.cart_type }}"
  >
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {% render 'search-modal' %}

    <div class="visually-hidden" id="LiveRegion" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="toast-region" id="ToastRegion"></div>

    <script type="application/json" id="HaldenConfig">
      {
        "routes": {
          "cart": {{ routes.cart_url | json }},
          "cartAdd": {{ routes.cart_add_url | json }},
          "cartChange": {{ routes.cart_change_url | json }},
          "cartUpdate": {{ routes.cart_update_url | json }},
          "cartJson": {{ routes.cart_url | append: '.js' | json }},
          "search": {{ routes.search_url | json }},
          "predictiveSearch": {{ routes.predictive_search_url | json }},
          "root": {{ routes.root_url | json }}
        },
        "settings": {
          "cartType": {{ settings.cart_type | json }},
          "openCartOnAdd": {{ settings.cart_open_on_add | json }}
        },
        "strings": {
          "addToCart": {{ 'products.product.add_to_cart' | t | json }},
          "soldOut": {{ 'products.product.sold_out' | t | json }},
          "unavailable": {{ 'products.product.unavailable' | t | json }},
          "adding": {{ 'products.product.adding' | t | json }},
          "added": {{ 'products.product.added' | t | json }},
          "cartError": {{ 'cart.general.error' | t | json }},
          "cartUpdated": {{ 'cart.general.updated' | t | json }},
          "itemRemoved": {{ 'cart.general.item_removed' | t | json }},
          "quantityMax": {{ 'cart.general.quantity_max' | t | json }},
          "searchError": {{ 'search.general.error' | t | json }},
          "searchLoading": {{ 'search.general.loading' | t | json }},
          "searchResultsOne": {{ 'search.general.results_one' | t | json }},
          "searchResultsOther": {{ 'search.general.results_other' | t | json }},
          "searchNoResults": {{ 'search.general.no_results_short' | t | json }},
          "filtersLoading": {{ 'collections.filters.loading' | t | json }},
          "filtersUpdated": {{ 'collections.filters.updated' | t | json }},
          "close": {{ 'accessibility.close' | t | json }},
          "copied": {{ 'general.share.copied' | t | json }},
          "zoomIn": {{ 'products.product.zoom' | t | json }},
          "mediaOf": {{ 'products.product.media_of' | t | json }}
        }
      }
    </script>
  </body>
</html>
